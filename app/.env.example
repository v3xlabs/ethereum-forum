DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
RUST_LOG=info

# LLM features (topic summaries + activity digest) against any OpenAI-compatible API.
# Optional: leave unset to disable them.
# LLM_API_KEY=sk-replaceme
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=mistralai/ministral-3b
# LLM_DIGEST_MODEL=mistralai/ministral-3b

# Langfuse LLM tracing. Optional: leave unset to disable tracing entirely.
# Start the stack with `docker compose -f compose.langfuse.yml up -d` (UI on 3100).
# LANGFUSE_HOST=http://localhost:3100
# LANGFUSE_PUBLIC_KEY=pk-lf-ethforum-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-ethforum-local-dev
# LANGFUSE_PROJECT_ID=ethereum-forum
# LANGFUSE_ENVIRONMENT=development
# Per-field cap on captured prompts and completions. These go to Langfuse only,
# never into llm_runs.trace.
# LANGFUSE_MAX_PAYLOAD_CHARS=20000
# Widens which tracing targets are exported; defaults to the LLM modules only.
# OTEL_TRACE_TARGETS=ethereum_forum=info

# Ethereum protocol calendar (public iCal feed)
ICAL_URL=https://calendar.google.com/calendar/ical/c_upaofong8mgrmrkegn7ic7hk5s%40group.calendar.google.com/public/basic.ics

# Example for Google OAuth
SSO_PROVIDERS__google__client_id=xxxx
SSO_PROVIDERS__google__client_secret=xxxx
SSO_PROVIDERS__google__issuer_url=https://accounts.google.com
SSO_PROVIDERS__google__redirect_uri=http://localhost:5173/sso/google/callback

# JWT Settings
SSO_JWT_SECRET=abcdefghijklmnop
SSO_JWT_EXPIRY_HOURS=24

MEILI_KEY=masterKey
MEILI_HOST=http://localhost:7700
ADMIN_API_KEY=masterKey
